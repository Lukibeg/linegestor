# ---------------------------------------------------------------
# Configuração do Gestor. Copie para .env e preencha.
# Nunca coloque este arquivo preenchido no repositório.
# ---------------------------------------------------------------

# Endereço do banco PostgreSQL
DATABASE_URL="postgresql://postgres:gestor_dev@localhost:5432/gestor_dev"

# Chave-mestra que cifra as senhas guardadas (SSH, tronco, Omniboard...).
# 32 bytes em base64. Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se perder esta chave, as senhas guardadas ficam irrecuperáveis. Guarde fora do servidor também.
SECRETS_MASTER_KEY=""

# Segredo que assina o cookie de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=""

# Porta da API e endereço do site (para CORS e cookies)
PORT=3333
WEB_ORIGIN="http://localhost:5173"

# "development" | "production"
NODE_ENV=development
