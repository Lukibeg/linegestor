# ---------------------------------------------------------------
# Configuração do Ingline Gestão. Copie para .env e preencha.
# Nunca coloque este arquivo preenchido no repositório (.gitignore já cuida disso).
# No servidor: chmod 600 .env
# ---------------------------------------------------------------

# ---- vale para os dois ambientes ----

# Chave-mestra que cifra as senhas guardadas (SSH, tronco, Omniboard...).
# 32 bytes em base64. Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se perder esta chave, as senhas guardadas ficam irrecuperáveis. Guarde uma cópia FORA do servidor
# (gerenciador de senhas da empresa). A de produção é diferente da de desenvolvimento.
SECRETS_MASTER_KEY=""

# Segredo que assina o cookie de sessão. Qualquer texto longo e aleatório; também diferente por ambiente.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""


# ---- desenvolvimento (sua máquina) ----

DATABASE_URL="postgresql://postgres:gestor_dev@localhost:5432/gestor_dev"
PORT=3333
WEB_ORIGIN="http://localhost:5173"
NODE_ENV=development


# ---- produção (VPS, com docker-compose.prod.yml) ----
# Descomente este bloco no .env do servidor e apague o de desenvolvimento acima.

# NODE_ENV=production
# DOMINIO=gestao.inglinesystems.com.br
# DB_PASSWORD=""            # senha do PostgreSQL dentro do servidor; gere uma longa e aleatória
# BACKUP_DIR=./backups      # onde os backups diários ficam
# O envio do backup para o Google Drive e os avisos de queda NÃO ficam aqui:
# são preenchidos na tela, em Administração › Ajustes, por quem administra o sistema.

# Só na primeira carga (pnpm db:seed), para criar o primeiro administrador.
# Depois de entrar e trocar a senha, apague estas duas linhas do .env.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
