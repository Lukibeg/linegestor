# Porta de entrada do Ingline Gestão.
# O Caddy resolve HTTPS sozinho (certificado Let's Encrypt, renovação automática),
# manda todo http para https e põe os cabeçalhos de segurança na frente do sistema.
# O nome do domínio vem do .env (DOMINIO=gestao.inglinesystems.com.br).
{
	# O robô do LineChat manda a chave de API no endereço (?chave=…: o bloco "Enviar webhook" não aceita
	# cabeçalho). O registro de erros do Caddy (o `docker compose logs caddy`) escreve o endereço inteiro;
	# aqui a chave vira REDACTED. O cabeçalho Authorization e o cookie o Caddy já esconde sozinho.
	log default {
		output stderr
		format filter {
			request>uri query {
				replace chave REDACTED
			}
		}
	}

	# Sem o HTTP/3 (o QUIC, por UDP) desde o 2.1.3: só HTTP/1.1 e HTTP/2, pelo TCP de sempre. O Luan (27/10): "do
	# nada o gestão fica lento mesmo com a internet boa, ele fica carregando e n vai" — no Edge dele, a conexão
	# HTTP/3 com o servidor ficava presa, sem erro (o servidor respondia em milissegundos; o "Flush socket pools"
	# do Edge destravou na hora). O HTTP/2 é tão rápido quanto para o Gestor e não tem esse engasgo. Mudou este
	# bloco? O Caddy só relê o arquivo recriado: `docker compose -f docker-compose.prod.yml up -d --force-recreate caddy`.
	servers {
		protocols h1 h2
	}
}

{$DOMINIO} {
	encode zstd gzip

	header {
		# navegador só volta por https neste domínio, por 1 ano
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# nada de adivinhar tipo de arquivo
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# O Content-Security-Policy (de onde a página carrega coisas e QUEM pode abrir o Gestor dentro
		# de um iframe) NÃO fica mais aqui desde a 2.0: quem manda é o próprio sistema, em toda resposta
		# (apps/api/src/plugins/seguranca.ts), num lugar só. É lá porque a lista de sites que podem abrir
		# o Gestor dentro deles (o menu do LineChat, outros programas) é escolhida na tela, em
		# Chamados › Ajustes › Integrações — e o Caddy não sabe ler o banco. As outras regras do CSP
		# continuam as mesmas de antes (tudo vem daqui; as fontes, do Google Fonts; nada de plugin; o
		# formulário só posta para o próprio site).
		# O X-Frame-Options "DENY" saiu pelo mesmo motivo: ele só sabe dizer "ninguém" ou "só eu", e o
		# frame-ancestors do sistema já diz quem pode (os navegadores de hoje seguem o frame-ancestors).
		# Não ponha nenhum dos dois de volta aqui: o Caddy passaria por cima do que o sistema manda e o
		# Gestor deixaria de abrir dentro do LineChat.
		-Server
	}

	reverse_proxy app:3333 {
		health_uri /api/health
		health_interval 30s
	}

	log {
		output file /var/log/caddy/acesso.log {
			roll_size 20mb
			roll_keep 10
		}
		# a chave do robô (?chave=…) não fica no registro de acesso: vira REDACTED (2.0.1)
		format filter {
			request>uri query {
				replace chave REDACTED
			}
		}
	}
}
