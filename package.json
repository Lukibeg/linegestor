{
  "name": "gestor",
  "private": true,
  "version": "0.1.0",
  "description": "Ingline Gestão — cadastro central de clientes, produtos, numeração (DIDs) e equipamentos.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @gestor/db migrate",
    "db:seed": "pnpm --filter @gestor/db seed",
    "db:seed:demo": "pnpm --filter @gestor/db seed:demo",
    "db:2fa-off": "pnpm --filter @gestor/db 2fa-off",
    "enviar-backup": "pnpm --filter @gestor/api enviar-backup",
    "novidades:importar": "pnpm --filter @gestor/api novidades:importar",
    "novidades:demo": "node scripts/gerar-novidades-demo.mjs",
    "db:docs": "pnpm --filter @gestor/db docs:gen"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
